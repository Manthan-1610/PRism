s_url": "https://api.github.com/users/ekxnsh22005/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "active_lock_reason": null, "merged": true, "mergeable": null, "rebaseable": null, "mergeable_state": "unknown", "merged_by": {"login": "mannubaveja007", "id": 142614912, "node_id": "U_kgDOCIAhgA", "avatar_url": "https://avatars.githubusercontent.com/u/142614912?v=4", "gravatar_id": "", "url": "https://api.github.com/users/mannubaveja007", "html_url": "https://github.com/mannubaveja007", "followers_url": "https://api.github.com/users/mannubaveja007/followers", "following_url": "https://api.github.com/users/mannubaveja007/following{/other_user}", "gists_url": "https://api.github.com/users/mannubaveja007/gists{/gist_id}", "starred_url": "https://api.github.com/users/mannubaveja007/starred{/owner}{/repo}", "subscriptions_url": "https://api.github.com/users/mannubaveja007/subscriptions", "organizations_url": "https://api.github.com/users/mannubaveja007/orgs", "repos_url": "https://api.github.com/users/mannubaveja007/repos", "events_url": "https://api.github.com/users/mannubaveja007/events{/privacy}", "received_events_url": "https://api.github.com/users/mannubaveja007/received_events", "type": "User", "user_view_type": "public", "site_admin": false}, "comments": 2, "review_comments": 0, "maintainer_can_modify": false, "commits": 1, "additions": 29, "deletions": 0, "changed_files": 1}, "files": [{"sha": "82f2030ba502fa4a947732250004dcb466907e40", "filename": "java/arrays/MaxSubarraySum.java", "status": "added", "additions": 29, "deletions": 0, "changes": 29, "blob_url": "https://github.com/mannubaveja007/DSA-LeetCode/blob/5b97e082aa0f6a4a56da4b2a7b4940026445b63c/java%2Farrays%2FMaxSubarraySum.java", "raw_url": "https://github.com/mannubaveja007/DSA-LeetCode/raw/5b97e082aa0f6a4a56da4b2a7b4940026445b63c/java%2Farrays%2FMaxSubarraySum.java", "contents_url": "https://api.github.com/repos/mannubaveja007/DSA-LeetCode/contents/java%2Farrays%2FMaxSubarraySum.java?ref=5b97e082aa0f6a4a56da4b2a7b4940026445b63c", "patch": "@@ -0,0 +1,29 @@\n+public class MaxSubarraySum {\n+    public static int maxSubArray(int[] nums) {\n+        if (nums == null || nums.length == 0) {\n+            return 0;\n+        }\n+\n+        // 'max_so_far' stores the maximum subarray sum found up to the current point.\n+        int max_so_far = nums[0];\n+        // 'current_max' stores the maximum sum ending at the current position.\n+        int current_max = nums[0];\n+\n+        for (int i = 1; i < nums.length; i++) {\n+            // Option 1: Start a new subarray at nums[i]\n+            // Option 2: Extend the previous subarray\n+            current_max = Math.max(nums[i], current_max + nums[i]);\n+\n+            // Update the overall maximum sum found globally\n+            max_so_far = Math.max(max_so_far, current_max);\n+        }\n+\n+        return max_so_far;\n+    }\n+\n+    public static void main(String[] args) {\n+        int[] nums = {-2, 1, -3, 4, -1, 2, 1, -5, 4};\n+        int maxSum = maxSubArray(nums);\n+        System.out.println(\"Maximum contiguous subarray sum: \" + maxSum); // Output: 6 (from [4, -1, 2, 1])\n+    }\n+}"}], "has_contributing": true}