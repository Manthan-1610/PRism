 "filename": "C++/.DS_Store", "status": "added", "additions": 0, "deletions": 0, "changes": 0, "blob_url": "https://github.com/abhisek247767/LeetCode2024-6Companies30Days/blob/0c83c0d32adc3580879f0763fdd2d0aff0d27150/C%2B%2B%2F.DS_Store", "raw_url": "https://github.com/abhisek247767/LeetCode2024-6Companies30Days/raw/0c83c0d32adc3580879f0763fdd2d0aff0d27150/C%2B%2B%2F.DS_Store", "contents_url": "https://api.github.com/repos/abhisek247767/LeetCode2024-6Companies30Days/contents/C%2B%2B%2F.DS_Store?ref=0c83c0d32adc3580879f0763fdd2d0aff0d27150"}, {"sha": "a10a446f987ad67c0d6c88762340d28ba7bb31e4", "filename": "C++/find duplicate number/FindDuplicateNumber.cpp", "status": "modified", "additions": 31, "deletions": 18, "changes": 49, "blob_url": "https://github.com/abhisek247767/LeetCode2024-6Companies30Days/blob/0c83c0d32adc3580879f0763fdd2d0aff0d27150/C%2B%2B%2Ffind%20duplicate%20number%2FFindDuplicateNumber.cpp", "raw_url": "https://github.com/abhisek247767/LeetCode2024-6Companies30Days/raw/0c83c0d32adc3580879f0763fdd2d0aff0d27150/C%2B%2B%2Ffind%20duplicate%20number%2FFindDuplicateNumber.cpp", "contents_url": "https://api.github.com/repos/abhisek247767/LeetCode2024-6Companies30Days/contents/C%2B%2B%2Ffind%20duplicate%20number%2FFindDuplicateNumber.cpp?ref=0c83c0d32adc3580879f0763fdd2d0aff0d27150", "patch": "@@ -1,24 +1,37 @@\n #include <iostream>\n #include <vector>\n-#include <unordered_map>\n using namespace std;\n-class Solution\n-{\n+\n+class Solution {\n public:\n-    int findDuplicate(vector<int> &nums)\n-    {\n-        unordered_map<int, int> mp;\n-        for (int i = 0; i < nums.size(); i++)\n-        {\n-            mp[nums[i]]++;\n+    int findDuplicate(vector<int>& nums) {\n+        // Phase 1: Finding the intersection point in the cycle\n+        int slow = nums[0];\n+        int fast = nums[0];\n+\n+        do {\n+            slow = nums[slow];         // Move slow pointer by 1 step\n+            fast = nums[nums[fast]];   // Move fast pointer by 2 steps\n+        } while (slow != fast);        // Loop until they meet inside the cycle\n+\n+        // Phase 2: Finding the entrance to the cycle (duplicate number)\n+        slow = nums[0];                // Reset slow to start\n+        while (slow != fast) {\n+            slow = nums[slow];         // Move both pointers 1 step at a time\n+            fast = nums[fast];\n         }\n-        for (auto it : mp)\n-        {\n-            if (it.second > 1)\n-            {\n-                return it.first;\n-            }\n-        }\n-        return -1;\n+\n+        return slow;                   // The duplicate number\n     }\n-};\n\\ No newline at end of file\n+};\n+\n+int main() {\n+    Solution sol;\n+    vector<int> nums = {1, 3, 4, 2, 2};\n+    cout << \"Duplicate number is: \" << sol.findDuplicate(nums) << endl;\n+    return 0;\n+}\n+\n+\n+//Time Complexity: O(n)\n+//Space Complexity: O(1)\n\\ No newline at end of file"}], "has_contributing": true}