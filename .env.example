# GitHub REST API. Classic token scope: public_repo.
GITHUB_TOKEN=

# DigitalOcean Gradient serverless inference.
# Base URL is https://inference.do-ai.run/v1
# Pick open-weight ids from GET /v1/models. Leave proprietary ids unused.
MODEL_ACCESS_KEY=
SMALL_MODEL=
LARGE_MODEL=
# Dollars per million tokens, copied from the model page that morning.
SMALL_INPUT_PER_MILLION=0
SMALL_OUTPUT_PER_MILLION=0
LARGE_INPUT_PER_MILLION=0
LARGE_OUTPUT_PER_MILLION=0

# Snowflake. Account looks like xy12345.us-east-2.aws
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_ROLE=

# Set to 1 to read fixtures/ and skip the network.
PRISM_USE_CACHE=0
SNOWFLAKE_DISABLED=0
